# ASUS ROG Pelta 2.4 GHz dongle (0b05:1b84), HID interface 3.
# Creates a stable /dev/pelta-hid and gives the logged-in user access to it,
# so nothing needs root and the hidrawN number never matters.
SUBSYSTEM=="hidraw", IMPORT{builtin}="usb_id", ENV{ID_VENDOR_ID}=="0b05", ENV{ID_MODEL_ID}=="1b84", ENV{ID_USB_INTERFACE_NUM}=="03", SYMLINK+="pelta-hid", TAG+="uaccess"
